# URL pública del sitio (sin barra final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca exponer en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago > Tus integraciones > Credenciales (usar las de prueba en desarrollo)
MERCADOPAGO_ACCESS_TOKEN=
# Mercado Pago > Tus integraciones > Webhooks > Clave secreta
MERCADOPAGO_WEBHOOK_SECRET=

# Bunny Stream > Video Library > API / Security (Token Authentication)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_KEY=
